{
    "name": "overthink/array-item",
    "description": "A fluent, typed accessor for reading and manipulating array data in Laravel apps.",
    "keywords": [
        "overthink",
        "laravel",
        "array-item"
    ],
    "homepage": "https://github.com/MarkoDevelop/array-item",
    "license": "MIT",
    "authors": [
        {
            "name": "Marko Zagar",
            "email": "marko.zagar@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "spatie/laravel-package-tools": "^1.93.2",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "ext-intl": "*",
        "laravel/pint": "^1.30",
        "nunomaduro/collision": "^8.9",
        "larastan/larastan": "^3.9.3",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^4.7",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-ray": "^1.43"
    },
    "suggest": {
        "ext-intl": "Required to use Number::spell(), Number::ordinal(), Number::currency() and Number::percentage()."
    },
    "autoload": {
        "psr-4": {
            "Overthink\\ArrayItem\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Overthink\\ArrayItem\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Overthink\\ArrayItem\\ArrayItemServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
